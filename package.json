{
  "name": "mozis-app-2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:views": "tsx --env-file=.env scripts/aplicar-sql.ts sql/views.sql",
    "sync": "tsx --env-file=.env scripts/sync-from-sheets.ts",
    "reconcile": "tsx --env-file=.env scripts/reconcile.ts",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "inspect": "tsx scripts/inspect-xlsx.ts",
    "invariantes": "tsx --env-file=.env scripts/invariantes.ts",
    "typecheck": "tsc --noEmit",
    "checar-form": "node scripts/checar-form.mjs",
    "db:sql": "tsx --env-file=.env scripts/aplicar-sql.ts",
    "verificar-e2e": "tsx --env-file=.env scripts/verificar-e2e.ts",
    "backfill-series": "tsx --env-file=.env scripts/backfill-series.ts",
    "corrigir-recorrencias": "tsx --env-file=.env scripts/corrigir-recorrencias-adiantadas.mts",
    "_comentario": "Os :teste apontam para a branch do Neon. A branch nasce como cópia da produção e nada nela chega ao app de vocês — é onde as fases de React são exercitadas antes de virar merge.",
    "db:migrate:teste": "DATABASE_URL=$(grep \"^DATABASE_URL=\" .env.teste | cut -d= -f2-) drizzle-kit migrate",
    "db:views:teste": "tsx --env-file=.env.teste scripts/aplicar-sql.ts sql/views.sql",
    "invariantes:teste": "tsx --env-file=.env.teste scripts/invariantes.ts",
    "backfill-series:teste": "tsx --env-file=.env.teste scripts/backfill-series.ts",
    "corrigir-recorrencias:teste": "tsx --env-file=.env.teste scripts/corrigir-recorrencias-adiantadas.mts",
    "verificar-e2e:teste": "tsx --env-file=.env.teste scripts/verificar-e2e.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
